# One workspace's connection for the Media worker. Copy to ~/.config/marvin-media/<workspace>.env (mode 600) and fill in, e.g.
#   install -m 600 docker/worker.env.example ~/.config/marvin-media/mash-burn-co.env
# Never commit the real one.
MARVIN_API_URL=https://your-marvin.example.com
# A token pinned to the ONE workspace this worker serves: marvin user tokens create --name media-worker --pin <workspace>
# It reads and writes that workspace's entries and files.
MARVIN_USER_TOKEN=
# Seconds between polls for queued jobs (default 3).
# WORKER_POLL_SECONDS=3
